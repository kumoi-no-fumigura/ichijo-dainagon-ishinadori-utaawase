 "blocks": [
  {
   "id": "gunsho08-ichijo-dainagon-ishinadori-0001",
   "pid": "1879502",
   "pages": [
    472
   ],
   "text": "一條大納言家歌合〔舊本行書躰〕題石名取左數まさるかたに拾へる石なれはてにかゝりぬる千代にも有哉右底の石のあらはれてゆく水瀨川水際のおこるしるしなりけり左あまたたひひきつむ石の數はみな君か千年のためしなりけり右かちまけを何かいふへきたちゐする舞のけしきを人はみよかし左さほ〳〵に思ひこそやれなか濱の眞砂の中にすたつつるのこ右しら波のたちぬにいのるかひあれと玉津島ての神のしるらし左君か代の數にさり置さゝれいしのうらふの山さまつなれる哉右",
   "poems": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6",
    "7"
   ],
   "lb": []
  },
  {
   "id": "gunsho08-ichijo-dainagon-ishinadori-0002",
   "pid": "1879502",
   "pages": [
    473
   ],
   "text": "天地のふくろのかすし多かれは思ふ事なきけふにもあるかな左みとりこの手とにとれるさゝれ石の行末遠きためしなりける右汀には石のみならすさりつめは濵のあなたはかひもあらしな左いさゝしくみにもやさりて見ゆるかな荒磯波も心よすれは右右一條大納言家歌合以古寫一本校合",
   "poems": [
    "8",
    "9",
    "10",
    "11"
   ],
   "lb": [],
   "notes": [
    {
     "a": "右一條大納言家歌合",
     "n": "歌圖",
     "k": "その他"
    }
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "數まさるかたに拾へる石なれはてにかゝりぬる千代にも有哉",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "底の石のあらはれてゆく水瀨川水際のおとるしるしなりけり",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あまたたひひきつむ石の數はみな君か千年のためしなりけり",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "かちまけを何かいふへきたちゐする舞のけしきを人はみよかし",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "とほ〓〓に思ひこそやれなか濱の眞砂の中にすたつつるのこ",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "しら波のたちゐにいのるかひあれと玉津島ての神のしるらし",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "君か代の數にとり置さゝれいしのうらふの山とまつなれる哉",
   "kana": "",
   "speaker": "",
   "page": 472,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "天地のふくろのかすし多かれは思ふ事なきけふにもあるかな",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "みとりこの手とにとれるさゝれ石の行末遠きためしなりける",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "汀には石のみならすとりつめは濵のあなたはかひもあらしな",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "いとゝしくみにもやさりて見ゆるかな荒磯波も心よすれは",
   "kana": "",
   "speaker": "",
   "page": 473,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
